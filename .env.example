# Copy to .env and replace all passwords before starting Compose.
PG_ADMIN_PASSWORD=replace-with-a-random-admin-password
PG_MIGRATION_PASSWORD=replace-with-a-random-migration-password
PG_RUNTIME_PASSWORD=replace-with-a-random-runtime-password
PG_WORKER_PASSWORD=replace-with-a-random-worker-password
DATABASE_URL=postgresql+asyncpg://docweave_runtime:replace-with-a-random-runtime-password@127.0.0.1:55432/docweave
MIGRATION_DATABASE_URL=postgresql+asyncpg://docweave_migrator:replace-with-a-random-migration-password@127.0.0.1:55432/docweave
TEST_DATABASE_URL=postgresql+asyncpg://docweave_runtime:replace-with-a-random-runtime-password@127.0.0.1:55433/docweave_test
TEST_MIGRATION_DATABASE_URL=postgresql+asyncpg://docweave_migrator:replace-with-a-random-migration-password@127.0.0.1:55433/docweave_test
WORKER_DATABASE_URL=postgresql+asyncpg://docweave_worker:replace-with-a-random-worker-password@127.0.0.1:55432/docweave
TEST_WORKER_DATABASE_URL=postgresql+asyncpg://docweave_worker:replace-with-a-random-worker-password@127.0.0.1:55433/docweave_test
# Private generated artifacts; never serve this directory from HTTP.
INGESTION_STORAGE_ROOT=storage

# Local backend auth profile. Generate random secrets and a Fernet key.
KC_DB_PASSWORD=replace-with-a-random-identity-db-password
KC_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-random-admin-password
OIDC_CLIENT_SECRET=replace-with-a-random-client-secret
AUTH_ENCRYPTION_KEY=replace-with-a-Fernet-generated-key
APP_ORIGIN=http://127.0.0.1:58000
OIDC_ISSUER=http://127.0.0.1:58080/realms/docweave
OIDC_CLIENT_ID=docweave
AUTH_LOCALHOST_HTTP=true
# Enable only after configuring the corresponding broker in Keycloak.
OIDC_GOOGLE_ENABLED=false
OIDC_GITHUB_ENABLED=false
