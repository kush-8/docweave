# Copy to .env and replace all passwords before starting Compose.
PG_ADMIN_PASSWORD=replace-with-a-random-admin-password
PG_MIGRATION_PASSWORD=replace-with-a-random-migration-password
PG_RUNTIME_PASSWORD=replace-with-a-random-runtime-password
DATABASE_URL=postgresql+asyncpg://docweave_runtime:replace-with-a-random-runtime-password@127.0.0.1:55432/docweave
MIGRATION_DATABASE_URL=postgresql+asyncpg://docweave_migrator:replace-with-a-random-migration-password@127.0.0.1:55432/docweave
TEST_DATABASE_URL=postgresql+asyncpg://docweave_runtime:replace-with-a-random-runtime-password@127.0.0.1:55433/docweave_test
TEST_MIGRATION_DATABASE_URL=postgresql+asyncpg://docweave_migrator:replace-with-a-random-migration-password@127.0.0.1:55433/docweave_test
